<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Activity_Interaction_Coefficient_Calculator_UEM1.CoefficientConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="活度相互作用系数转换工具" 
        Height="760" Width="850" 
        MinHeight="700" MinWidth="800"
        Background="#F5F5F5"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#757575"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#616161"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#424242"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="活度相互作用系数转换" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#1565C0"
                   HorizontalAlignment="Center"/>

        <!-- 输入参数区域 -->
        <Border Grid.Row="2" 
                BorderBrush="#BDBDBD" 
                BorderThickness="1" 
                Background="White"
                CornerRadius="6"
                Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 基体组分 -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="基体组分 (Matrix k):" 
                           Style="{StaticResource HeaderLabel}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="Matrix_ComboBox" 
                          Grid.Row="0" Grid.Column="1"
                          Style="{StaticResource ModernComboBox}"
                          IsEditable="True">
                    <ComboBoxItem Content="Fe"/>
                    <ComboBoxItem Content="Ni"/>
                    <ComboBoxItem Content="Co"/>
                    <ComboBoxItem Content="Al"/>
                    <ComboBoxItem Content="Cu"/>
                    <ComboBoxItem Content="Mn"/>
                </ComboBox>

                <!-- 溶质组分 i -->
                <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="溶质组分 i:" 
                           Style="{StaticResource HeaderLabel}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="SoluteI_ComboBox" 
                          Grid.Row="2" Grid.Column="1"
                          Style="{StaticResource ModernComboBox}"
                          IsEditable="True">
                    <ComboBoxItem Content="Si"/>
                    <ComboBoxItem Content="Cr"/>
                    <ComboBoxItem Content="Mn"/>
                    <ComboBoxItem Content="C"/>
                    <ComboBoxItem Content="N"/>
                    <ComboBoxItem Content="O"/>
                </ComboBox>

                <!-- 溶质组分 j -->
                <TextBlock Grid.Row="4" Grid.Column="0" 
                           Text="溶质组分 j:" 
                           Style="{StaticResource HeaderLabel}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="SoluteJ_ComboBox" 
                          Grid.Row="4" Grid.Column="1"
                          Style="{StaticResource ModernComboBox}"
                          IsEditable="True">
                    <ComboBoxItem Content="Si"/>
                    <ComboBoxItem Content="Cr"/>
                    <ComboBoxItem Content="Mn"/>
                    <ComboBoxItem Content="C"/>
                    <ComboBoxItem Content="N"/>
                    <ComboBoxItem Content="O"/>
                </ComboBox>

                <!-- 转换方向 -->
                <TextBlock Grid.Row="6" Grid.Column="0" 
                           Text="转换方向:" 
                           Style="{StaticResource HeaderLabel}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="MoleToMass_RadioButton" 
                                 Content="摩尔分数 → 质量分数" 
                                 FontSize="14"
                                 Margin="0,0,30,0"
                                 VerticalAlignment="Center"
                                 IsChecked="True"
                                 Checked="ConversionDirection_Changed"/>
                    <RadioButton x:Name="MassToMole_RadioButton" 
                                 Content="质量分数 → 摩尔分数" 
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Checked="ConversionDirection_Changed"/>
                </StackPanel>

                <!-- 输入系数值 -->
                <TextBlock Grid.Row="8" Grid.Column="0" 
                           Text="待转换的系数值:" 
                           Style="{StaticResource HeaderLabel}"
                           VerticalAlignment="Center"/>
                <Grid Grid.Row="8" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 带上下标的符号显示区域 -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 主符号 ε 或 e -->
                        <TextBlock x:Name="MainSymbol_TextBlock" 
                                   Grid.Column="0"
                                   Text="ε"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1565C0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,2,0"/>

                        <!-- 上下标部分 -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Width="35" Height="50">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 上标 j (溶质j) -->
                            <TextBlock x:Name="Superscript_TextBlock" 
                                       Grid.Row="0"
                                       Text="j"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#1565C0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,0"/>

                            <!-- 下标 i (溶质i) -->
                            <TextBlock x:Name="Subscript_TextBlock" 
                                       Grid.Row="1"
                                       Text="i"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#1565C0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="0,0,0,0"/>
                        </Grid>

                        <!-- 等号 -->
                        <TextBlock Grid.Column="1"
                                   Text=" ="
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1565C0"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"/>
                    </Grid>

                    <!-- 输入框 -->
                    <TextBox x:Name="InputCoefficient_TextBox" 
                             Grid.Column="2"
                             Style="{StaticResource ModernTextBox}"
                             ToolTip="请输入数值，例如：-0.046"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 转换按钮 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ConvertBtn" 
                    Grid.Column="0"
                    Content="转换" 
                    Style="{StaticResource ModernButton}"
                    Height="45"
                    Click="ConvertBtn_Click"/>
            <Button x:Name="ClearBtn" 
                    Grid.Column="2"
                    Content="清空" 
                    Style="{StaticResource ClearButton}"
                    Height="45"
                    Click="ClearBtn_Click"/>
            <Button x:Name="CloseBtn" 
                    Grid.Column="4"
                    Content="关闭" 
                    Style="{StaticResource ClearButton}"
                    Height="45"
                    Click="CloseBtn_Click"/>
        </Grid>

        <!-- 结果显示区域 -->
        <Border Grid.Row="5" 
                BorderBrush="#4CAF50" 
                BorderThickness="2" 
                Background="#E8F5E9"
                CornerRadius="6"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 结果标题 -->
                <TextBlock Grid.Row="0" 
                           Text="转换结果" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#2E7D32"
                           HorizontalAlignment="Center"/>

                <!-- 分隔线 -->
                <Border Grid.Row="1" 
                        Height="2" 
                        Background="#4CAF50" 
                        Margin="0,5"/>

                <!-- 输入信息 -->
                <StackPanel Grid.Row="2">
                    <TextBlock FontSize="14" Foreground="#424242" Margin="0,0,0,5">
                        <Run Text="输入系数: " FontWeight="Bold"/>
                        <Run x:Name="InputInfo_Run" Text="--"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Foreground="#424242">
                        <Run Text="转换方向: " FontWeight="Bold"/>
                        <Run x:Name="ConversionDirection_Run" Text="--"/>
                    </TextBlock>
                </StackPanel>

                <!-- 转换结果 -->
                <Border Grid.Row="4" 
                        Background="White" 
                        BorderBrush="#4CAF50"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15">
                    <TextBlock FontSize="20" 
                               Foreground="#1B5E20" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center">
                        <Run Text="转换后的系数值: "/>
                        <Run x:Name="ResultValue_Run" Text="--" Foreground="#2E7D32"/>
                    </TextBlock>
                </Border>

                <!-- 计算详情 -->
                <TextBlock Grid.Row="6" 
                           x:Name="CalculationDetails_TextBlock"
                           FontSize="13" 
                           Foreground="#616161"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Text=""/>
            </Grid>
        </Border>

        <!-- 底部说明 -->
        <TextBlock Grid.Row="7" 
                   Text="注: 转换使用元素原子质量进行摩尔分数与质量分数之间的换算" 
                   FontSize="12" 
                   Foreground="#757575"
                   FontStyle="Italic"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
