<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Activity_Interaction_Coefficient_Calculator_UEM1.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Activity_Interaction_Coefficient_Calculator_UEM1"
        mc:Ignorable="d"
        Title="Activity Interaction Coefficients Calculator (Multi-Model) - WPF" 
        Height="850" Width="1400" 
        MinHeight="700" MinWidth="1200"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#757575"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#616161"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#424242"/>
        </Style>

        <Style x:Key="PropertyBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="ResultDisplayBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>

        <Style x:Key="DataGridCellCenteredText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White" Padding="5,3">
            <MenuItem Header="_数据库(_D)" FontSize="14">
                <MenuItem Header="_管理数据库(_M)" Click="ManageDatabase_Click" FontSize="14"/>
            </MenuItem>
            <MenuItem Header="_工具(_T)" FontSize="14">
                <MenuItem Header="_活度相互作用系数转换(_C)" Click="ConvertCoefficient_Click" FontSize="14"/>
            </MenuItem>
        </Menu>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    BorderBrush="#BDBDBD" 
                    BorderThickness="1" 
                    Background="White"
                    CornerRadius="6"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Matrix (k)" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Solute (i)" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Solute (j)" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="T (K)" Style="{StaticResource HeaderLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Model" Style="{StaticResource HeaderLabel}" Foreground="#1976D2"/>
                    <TextBlock Grid.Row="0" Grid.Column="5" Text="Excess Entropy" Style="{StaticResource HeaderLabel}" Foreground="#F57C00"/>

                    <ComboBox x:Name="k_comboBox" Grid.Row="1" Grid.Column="0" 
                              Margin="5,0" Style="{StaticResource ModernComboBox}" 
                              IsEditable="True">
                        <ComboBoxItem Content="Fe"/>
                        <ComboBoxItem Content="Ni"/>
                        <ComboBoxItem Content="Co"/>
                        <ComboBoxItem Content="Al"/>
                        <ComboBoxItem Content="Cu"/>
                        <ComboBoxItem Content="Mn"/>
                    </ComboBox>
                    <ComboBox x:Name="i_comboBox" Grid.Row="1" Grid.Column="1" 
                              Margin="5,0" Style="{StaticResource ModernComboBox}" 
                              IsEditable="True">
                        <ComboBoxItem Content="Si"/>
                        <ComboBoxItem Content="Cr"/>
                        <ComboBoxItem Content="Mn"/>
                        <ComboBoxItem Content="C"/>
                    </ComboBox>
                    <ComboBox x:Name="j_comboBox" Grid.Row="1" Grid.Column="2" 
                              Margin="5,0" Style="{StaticResource ModernComboBox}" 
                              IsEditable="True">
                        <ComboBoxItem Content="Co"/>
                        <ComboBoxItem Content="Cr"/>
                        <ComboBoxItem Content="Mn"/>
                        <ComboBoxItem Content="Ni"/>
                    </ComboBox>
                    <ComboBox x:Name="T_comboBox" Grid.Row="1" Grid.Column="3" 
                              Margin="5,0" Style="{StaticResource ModernComboBox}" 
                              IsEditable="True">
                        <ComboBoxItem Content="1873"/>
                        <ComboBoxItem Content="1723"/>
                    </ComboBox>
                    <ComboBox x:Name="model_comboBox" Grid.Row="1" Grid.Column="4" 
                              Margin="5,0" Style="{StaticResource ModernComboBox}" 
                              SelectedIndex="0">
                        <ComboBoxItem Content="UEM1"/>
                        <ComboBoxItem Content="UEM2"/>
                        <ComboBoxItem Content="UEM2_Adv"/>
                        <ComboBoxItem Content="Toop-Kohler"/>
                        <ComboBoxItem Content="Toop-Muggianu"/>
                        <ComboBoxItem Content="Muggianu"/>
                        <ComboBoxItem Content="GSM"/>
                    </ComboBox>
                    <StackPanel Grid.Row="1" Grid.Column="5" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center">
                        <RadioButton x:Name="yesentropyradiobtn" 
                                     Content="Yes" 
                                     GroupName="Entropy" 
                                     IsChecked="True"
                                     FontSize="14"
                                     VerticalAlignment="Center"/>
                        <RadioButton x:Name="noentropyradiobtn" 
                                     Content="No" 
                                     GroupName="Entropy" 
                                     Margin="20,0,0,0"
                                     FontSize="14"
                                     VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="5,0" VerticalAlignment="Center">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Images/phi.bmp" Width="28" Height="28" Margin="2" ToolTip="Electronegativity (Φ)"/>
                            <Border Grid.Column="1" Style="{StaticResource PropertyBorder}" Margin="4,0,0,0">
                                <TextBlock x:Name="kPhi_text" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Images/nws.bmp" Width="28" Height="28" Margin="2" ToolTip="Electron Density (nws¹/³)"/>
                            <Border Grid.Column="1" Style="{StaticResource PropertyBorder}" Margin="4,0,0,0">
                                <TextBlock x:Name="kNws_text" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Images/v.bmp" Width="28" Height="28" Margin="2" ToolTip="Molar Volume (V²/³)"/>
                            <Border Grid.Column="1" Style="{StaticResource PropertyBorder}" Margin="4,0,0,0">
                                <TextBlock x:Name="kV_text" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="5,0" VerticalAlignment="Center">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Images/phi.bmp" Width="28" Height="28" Margin="2" ToolTip="Electronegativity (Φ)"/>
                            <Border Grid.Column="1" Style="{StaticResource PropertyBorder}" Margin="4,0,0,0">
                                <TextBlock x:Name="iPhi_text" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Images/nws.bmp" Width="28" Height="28" Margin="2" ToolTip="Electron Density (nws¹/³)"/>
                            <Border Grid.Column="1" Style="{StaticResource PropertyBorder}" Margin="4,0,0,0">
                                <TextBlock x:Name="iNws_text" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Images/V.bmp" Width="28" Height="28" Margin="2" ToolTip="Molar Volume (V²/³)"/>
                            <Border Grid.Column="1" Style="{StaticResource PropertyBorder}" Margin="4,0,0,0">
                                <TextBlock x:Name="iV_text" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="5,0" VerticalAlignment="Center">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Images/phi.bmp" Width="28" Height="28" Margin="2" ToolTip="Electronegativity (Φ)"/>
                            <Border Grid.Column="1" Style="{StaticResource PropertyBorder}" Margin="4,0,0,0">
                                <TextBlock x:Name="jPhi_text" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Images/nws.bmp" Width="28" Height="28" Margin="2" ToolTip="Electron Density (nws¹/³)"/>
                            <Border Grid.Column="1" Style="{StaticResource PropertyBorder}" Margin="4,0,0,0">
                                <TextBlock x:Name="jNws_text" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Images/V.bmp" Width="28" Height="28" Margin="2" ToolTip="Molar Volume (V²/³)"/>
                            <Border Grid.Column="1" Style="{StaticResource PropertyBorder}" Margin="4,0,0,0">
                                <TextBlock x:Name="jV_text" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="3" Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#F3E5F5" 
                                BorderBrush="#9C27B0" 
                                BorderThickness="1" 
                                CornerRadius="4"
                                Padding="15,10"
                                Height="80"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Phase State" 
                                           FontWeight="Bold" 
                                           FontSize="14"
                                           HorizontalAlignment="Center" 
                                           Foreground="#7B1FA2"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="liquidradioButton" 
                                                 Content="Liquid" 
                                                 GroupName="Phase" 
                                                 IsChecked="True"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton x:Name="solidradiobtn" 
                                                 Content="Solid" 
                                                 GroupName="Phase" 
                                                 Margin="20,0,0,0"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 修改后的 Activity Coefficient 显示区域 -->
                        <Border Grid.Row="0" Grid.Column="2"
        Style="{StaticResource ResultDisplayBorder}"
        VerticalAlignment="Top"
        Height="80"
        MinWidth="180">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Activity Coefficient" 
                   FontWeight="Bold" 
                   FontSize="12"
                   HorizontalAlignment="Center" 
                   Foreground="#2E7D32"
                   Margin="0,0,0,5"/>

                                <!-- 修改后的公式显示部分 -->
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ln 部分 -->
                                    <TextBlock Grid.Column="0"
                       Text="ln " 
                       FontSize="17" 
                       Foreground="#1B5E20" 
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,2,0"/>

                                    <!-- γ 部分 -->
                                    <TextBlock Grid.Column="1"
                       Text="γ" 
                       FontSize="17" 
                       Foreground="#1B5E20" 
                       FontWeight="SemiBold" 
                       FontFamily="Cambria Math"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0"/>

                                    <!-- 上下标部分：⁰ 的底部对齐 γ 的顶部，⁰ 和 i 在同一垂直线 -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Height="24" Margin="0,0,2,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- 上标 ⁰：在上半部分的底部 -->
                                        <TextBlock Grid.Row="0" 
                           Text="⁰" 
                           FontSize="10" 
                           Foreground="#1B5E20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"/>

                                        <!-- 下标 i：在下半部分的顶部 -->
                                        <TextBlock Grid.Row="1"
                           x:Name="gammaSubscript_run" 
                           Text="i" 
                           FontSize="12" 
                           Foreground="#1B5E20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- = 部分 -->
                                    <TextBlock Grid.Column="3"
                       Text=" = " 
                       FontSize="17" 
                       Foreground="#1B5E20" 
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="2,0,2,0"/>

                                    <!-- 值部分 -->
                                    <TextBlock Grid.Column="4"
                       x:Name="gammaValue_run" 
                       Text="--" 
                       FontSize="17" 
                       Foreground="#1B5E20" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="calbtn" 
                                    Grid.Column="0" 
                                    Content="Calculate" 
                                    Style="{StaticResource ModernButton}"
                                    Height="42"
                                    Click="calbtn_Click"/>
                            <Button x:Name="clearbtn" 
                                    Grid.Column="2" 
                                    Content="Clear" 
                                    Style="{StaticResource ClearButton}"
                                    Height="42"
                                    Click="clearbtn_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" 
                          Height="8" 
                          HorizontalAlignment="Stretch" 
                          Background="Transparent"
                          IsEnabled="False"/>

            <Border Grid.Row="2" 
                    BorderBrush="#BDBDBD" 
                    BorderThickness="1"
                    Background="White"
                    CornerRadius="6">
                <DataGrid x:Name="ResultDataGrid" 
                          Margin="0"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeight="32"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0"
                          BorderThickness="0"
                          Background="White"
                          AlternatingRowBackground="#FAFAFA" VerticalContentAlignment="Stretch">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="#1565C0"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderBrush" Value="#BBDEFB"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#BBDEFB"/>
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Solvent" Binding="{Binding Solvent}" Width="*" MinWidth="80" ElementStyle="{StaticResource DataGridCellCenteredText}"/>
                        <DataGridTextColumn Header="i" Binding="{Binding I}" Width="*" MinWidth="60" ElementStyle="{StaticResource DataGridCellCenteredText}"/>
                        <DataGridTextColumn Header="j" Binding="{Binding J}" Width="*" MinWidth="60" ElementStyle="{StaticResource DataGridCellCenteredText}"/>
                        <DataGridTextColumn Header="calcu." Binding="{Binding Calculate, StringFormat=F3}" Width="*" MinWidth="90" ElementStyle="{StaticResource DataGridCellCenteredText}"/>
                        <DataGridTextColumn Header="exp." Binding="{Binding JSPS}" Width="*" MinWidth="80" ElementStyle="{StaticResource DataGridCellCenteredText}"/>
                        <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="*" MinWidth="70" ElementStyle="{StaticResource DataGridCellCenteredText}"/>
                        <DataGridTextColumn Header="Entropy" Binding="{Binding Entropy}" Width="*" MinWidth="80" ElementStyle="{StaticResource DataGridCellCenteredText}"/>
                        <DataGridTextColumn Header="T (K)" Binding="{Binding Temp, StringFormat=F0}" Width="*" MinWidth="70" ElementStyle="{StaticResource DataGridCellCenteredText}"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="1.2*" MinWidth="100" ElementStyle="{StaticResource DataGridCellCenteredText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window>